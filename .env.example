# RedGravity API Keys Configuration
# Copy this file to .env and fill in your actual API keys

# Shodan (Service Detection) - REQUIRED
SHODAN_API_KEY_1=your_shodan_key_here
SHODAN_API_KEY_2=your_second_shodan_key_optional

# NVD (CVE Database) - REQUIRED
NVD_API_KEY=your_nvd_key_here

# Vulners (Enhanced CVE Intelligence) - RECOMMENDED
VULNERS_API_KEY=your_vulners_key_here

# AlienVault OTX (Threat Intelligence) - RECOMMENDED
OTX_API_KEY=your_otx_key_here

# AbuseIPDB (IP Reputation) - RECOMMENDED
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# Censys (Service Detection) - OPTIONAL
CENSYS_API_ID=your_censys_id_here
CENSYS_API_SECRET=your_censys_secret_here

# GreyNoise (Threat Intelligence) - OPTIONAL
GREYNOISE_API_KEY=your_greynoise_key_here
